# Session state — per CLAUDE.md#session-recovery
PROGRESS.md

# Agent / tool config — per CLAUDE.md#config-safety
.claude/
.gemini/
.codex/

# Sentinel runtime logs (created at runtime, not committed)
logs/

# Sentinel self-scan output (written by scan CLI; would create a feedback loop
# if committed and rescanned). WARN output was renamed from review-findings.md
# to sentinel-findings.md to avoid collision with the /review skill.
STUCK_FAILURES.md
STUCK_FAILURES.jsonl
sentinel-findings.md
sentinel-findings.jsonl
# Legacy WARN output name — kept gitignored so pre-rename artifacts don't
# get committed, and so /review skill output (same filename) stays local.
review-findings.md
review-findings.jsonl
# Multi-persona code review reports (local artifacts, not shipping output)
code-review-findings-*.md

# Sweep audit artifacts — JSON dumps of scan results. May contain
# credential patterns that would trigger P1-leaked-secret on re-scan
# (false positives or not). Keep local; re-generate by running the
# scripts/sweep_*.py entry points.
scripts/gitleaks_history_findings.json
scripts/leaked_secret_sweep_*.json
/tests/fixtures/**/STUCK_FAILURES.md
/tests/fixtures/**/STUCK_FAILURES.jsonl

# Generated dashboard output
dashboard/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# Transient llm-review packets (contain a diff; never commit)
.sentinel-llm-review-request.json
